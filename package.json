    "@sveltejs/adapter-netlify": "^5.2.3",
    "@sveltejs/kit": "^2.43.5",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^20.19.17",
    "@types/three": "^0.177.0",
    "@types/youtube": "^0.1.2",
    "@types/yt-player": "^3.5.4",
    "@yushijinhun/three-minifier-rollup": "^0.4.0",
    "eslint": "^9.36.0",
